# Função para criar tabela no formato do template
def criar_tabela(metrics_dict, modelo, balanceamento, conjunto):
    """Cria tabela no formato do template."""
    dados = {
        'Modelo': modelo,
        'Balanceamento': balanceamento,
        'Conjunto': conjunto,
        'Precisão (Curta)': metrics_dict.get('Precision (Curta)', np.nan),
        'Precisão (Média)': metrics_dict.get('Precision (Média)', np.nan),
        'Precisão (Longa)': metrics_dict.get('Precision (Longa)', np.nan),
        'Recall (Curta)': metrics_dict.get('Recall (Curta)', np.nan),
        'Recall (Média)': metrics_dict.get('Recall (Média)', np.nan),
        'Recall (Longa)': metrics_dict.get('Recall (Longa)', np.nan),
        'F1-Score (Curta)': metrics_dict.get('F1-Score (Curta)', np.nan),
        'F1-Score (Média)': metrics_dict.get('F1-Score (Média)', np.nan),
        'F1-Score (Longa)': metrics_dict.get('F1-Score (Longa)', np.nan),
        'Suporte (Curta)': metrics_dict.get('Support (Curta)', np.nan),
        'Suporte (Média)': metrics_dict.get('Support (Média)', np.nan),
        'Suporte (Longa)': metrics_dict.get('Support (Longa)', np.nan),
        'Média F1': metrics_dict.get('Macro avg F1', np.nan),
        'Média Ponderada F1': metrics_dict.get('Weighted avg F1', np.nan),
        'Acurácia': metrics_dict.get('Accuracy', np.nan)
    }
    return dados

