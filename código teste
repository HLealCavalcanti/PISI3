# 6.2. Função para extrair métricas por classe
def extrair_metricas(y_true, y_pred, classes):
    """Extrai métricas por classe para multiclasse."""
    report = classification_report(y_true, y_pred, output_dict=True)
    metricas = {}

    for classe in classes:
        if classe in report:
            metricas[f'Precision ({classe})'] = report[classe]['precision']
            metricas[f'Recall ({classe})'] = report[classe]['recall']
            metricas[f'F1-Score ({classe})'] = report[classe]['f1-score']
            metricas[f'Support ({classe})'] = report[classe]['support']

    metricas['Macro avg F1'] = report['macro avg']['f1-score']
    metricas['Weighted avg F1'] = report['weighted avg']['f1-score']
    metricas['Accuracy'] = accuracy_score(y_true, y_pred)

    return metricas

